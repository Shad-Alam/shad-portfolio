
# Load the Rails application
require_relative 'config/environment'

Parklife.application.configure do |config|
  # Define the Rack application for Parklife
  config.app = Rails.application

  # Build for a GitHub Pages project site served under /hello-world
  config.base = 'http://localhost:3000/hello-world'

  # Serve trailing slash-less URLs from GitHub Pages
  config.nested_index = false
end

Parklife.application.routes do
  root crawl: true
end
